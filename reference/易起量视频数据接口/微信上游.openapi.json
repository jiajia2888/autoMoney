          "201": {
            "description": "检查HTTP及业务错误；201也是正常状态。Cookie值不在示例中。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Profile"
                    },
                    {
                      "$ref": "#/components/schemas/UpstreamError"
                    }
                  ]
                },
                "example": {
                  "data": {
                    "selfAccountInfo": {
                      "username": "v_executor@finder",
