{
  "openapi": "3.0.3",
  "info": {
    "title": "易起量方案：微信投手号上游接口",
    "version": "1.0.0",
    "description": "2026-11-09，按源码与真实只读请求整理。包含扫码、身份、作者、作品及分享链接。点赞分爱心likeCount与拇指favCount；无已确认收藏数、播放量、评论正文或MP4下载接口。页面内部接口，非公开开放平台协议。示例均脱敏；status验证见x-validation。"
  },
  "servers": [
    {
      "url": "https://channels.weixin.qq.com",
      "description": "微信加热平台上游，须由后端持有自有投手Cookie调用"
    }
  ],
  "security": [
    {
      "PromoteSession": []
    }
  ],
  "components": {
    "securitySchemes": {
      "PromoteSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "promotewebsessionid",
        "description": "自行扫码取得的投手Cookie。浏览器Swagger不一定能跨域发送Cookie，使用后端或API客户端。"
      }
    },
    "schemas": {
      "Author": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "目标作者 finder_id，供作品查询使用"
          },
          "nickName": {
            "type": "string",
            "description": "昵称"
          },
          "headImgUrl": {
            "type": "string",
            "description": "头像URL"
          },
          "signature": {
            "type": "string",
            "description": "简介"
          },
          "authImgUrl": {
            "type": "string",
            "description": "认证图片"
          },
          "authProfession": {
            "type": "string",
            "description": "认证展示信息"
          },
          "exportUsername": {
            "type": "string",
            "description": "附加作者标识，原样保留"
          },
          "gender": {
            "type": "integer",
            "format": "int64",
            "description": "未经枚举核验"
          },
          "liveStatus": {
            "type": "integer",
            "format": "int64",
            "description": "未经枚举核验"
          },
          "permission": {
            "type": "integer",
            "format": "int64",
            "description": "未经枚举核验"
          },
          "roi2PromoteFlag": {
            "type": "integer",
            "format": "int64",
            "description": "未经枚举核验"
          },
          "isPrivate": {
            "type": "integer",
            "format": "int64",
            "description": "样本为整数，未经完整枚举核验"
          }
        },
        "required": [
          "username"
        ],
        "additionalProperties": true
      },
      "Video": {
        "type": "object",
        "properties": {
          "exportId": {
            "type": "string",
            "description": "网页作品标识；不可转成数值"
          },
          "globalExportId": {
            "type": "string",
            "description": "另一作品标识；不承诺跨会话稳定性"
          },
          "nonce": {
            "type": "string",
            "description": "分享接口 nonceId 的来源"
          },
          "description": {
            "type": "string",
            "description": "视频文案，不含自动语音转写"
          },
          "coverUrl": {
            "type": "string",
            "description": "封面，不是视频文件地址"
          },
          "createTime": {
            "type": "integer",
            "format": "int64",
            "description": "Unix秒时间戳"
          },
          "likeCount": {
            "type": "integer",
            "format": "int64",
            "description": "爱心点赞数，按易起量映射",
            "nullable": true
          },
          "favCount": {
            "type": "integer",
            "format": "int64",
            "description": "拇指点赞数，按易起量映射；不能当作收藏数",
            "nullable": true
          },
          "forwardCount": {
            "type": "integer",
            "format": "int64",
            "description": "转发/分享数量",
            "nullable": true
          },
          "commentCount": {
            "type": "integer",
            "format": "int64",
            "description": "评论数量，不是正文",
            "nullable": true
          },
          "accountInfo": {
            "$ref": "#/components/schemas/Author"
          },
          "flag": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          },
          "deleteTime": {
            "type": "integer",
            "format": "int64",
            "description": "样本为0，状态语义未核验"
          },
          "shoppingcartJumpinfo": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          },
          "finderComponent": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          },
          "profitableType": {
            "type": "integer",
            "format": "int64",
            "description": "枚举未核验"
          },
          "inquireInfo": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          }
        },
        "required": [
          "exportId"
        ],
        "additionalProperties": true
      },
      "LoginToken": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "description": "用于生成二维码，原样保留整个data"
              }
            },
            "required": [
              "token"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": true
      },
      "LoginStatus": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "format": "int64",
                "description": "0等待，5且acctStatus=1已扫码，1且acctStatus=1已确认，4过期"
              },
              "acctStatus": {
                "type": "integer",
                "format": "int64",
                "description": "账户状态，按状态组合判断"
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": true
      },
      "Profile": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "selfAccountInfo": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "description": "目标作者 finder_id，供作品查询使用"
                  },
                  "nickName": {
                    "type": "string",
                    "description": "昵称"
                  },
                  "headImgUrl": {
                    "type": "string",
                    "description": "头像URL"
                  },
                  "signature": {
                    "type": "string",
                    "description": "简介"
                  },
                  "authImgUrl": {
                    "type": "string",
                    "description": "认证图片"
                  },
                  "authProfession": {
                    "type": "string",
                    "description": "认证展示信息"
                  },
                  "exportUsername": {
                    "type": "string",
                    "description": "附加作者标识，原样保留"
                  },
                  "gender": {
                    "type": "integer",
                    "format": "int64",
                    "description": "未经枚举核验"
                  },
                  "liveStatus": {
                    "type": "integer",
                    "format": "int64",
                    "description": "未经枚举核验"
                  },
                  "permission": {
                    "type": "integer",
                    "format": "int64",
                    "description": "未经枚举核验"
                  },
                  "roi2PromoteFlag": {
                    "type": "integer",
                    "format": "int64",
                    "description": "未经枚举核验"
                  },
                  "isPrivate": {
                    "type": "integer",
                    "format": "int64",
                    "description": "样本为整数，未经完整枚举核验"
                  }
                },
                "required": [
                  "username"
                ],
                "additionalProperties": true
              }
            },
            "required": [
              "selfAccountInfo"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": true
      },
      "AuthorList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "list": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Author"
                }
              },
              "totalCount": {
                "type": "integer",
                "format": "int64"
              }
            },
            "required": [
              "list"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": true
      },
      "VideoPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "objects": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Video"
                }
              },
              "continueFlag": {
                "type": "boolean"
              },
              "lastBuf": {
                "type": "string",
                "description": "原样传回，不透明分页游标"
              }
            },
            "required": [
              "objects"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": true
      },
      "ShareLink": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "shortUrl": {
                "type": "string",
                "description": "分享页URL，不是MP4直链"
              }
            },
            "required": [
              "shortUrl"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": true
      },
      "UnverifiedSearch": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "feedInfos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "feedInfos"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": true
      },
      "UpstreamError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": true
      }
    }
  },
  "paths": {
    "/promote/api/web/auth/auth_login_token": {
      "post": {
        "operationId": "promoteLoginToken",
        "summary": "U1 取得扫码token",
        "parameters": [
          {
            "name": "_pageUrl",
            "in": "query",
            "required": true,
            "description": "传未编码的URL给HTTP库，由HTTP库编码一次",
            "schema": {
              "type": "string",
              "default": "https://channels.weixin.qq.com/promote/pages/platform/login-iframe"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": true
              },
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "检查HTTP及业务错误；201也是正常状态。Cookie值不在示例中。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/LoginToken"
                    },
                    {
                      "$ref": "#/components/schemas/UpstreamError"
                    }
                  ]
                },
                "example": {
                  "data": {
                    "token": "EXAMPLE_QR_TOKEN"
                  }
                }
              }
            }
          },
          "201": {
            "description": "检查HTTP及业务错误；201也是正常状态。Cookie值不在示例中。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/LoginToken"
                    },
                    {
                      "$ref": "#/components/schemas/UpstreamError"
                    }
                  ]
                },
                "example": {
                  "data": {
                    "token": "EXAMPLE_QR_TOKEN"
                  }
                }
              }
            }
          }
        },
        "security": [],
        "x-validation": "live_login_success"
      }
    },
    "/promote/api/web/auth/auth_login_status": {
      "post": {
        "operationId": "promoteLoginStatus",
        "summary": "U2 查询扫码状态并接收Set-Cookie",
        "parameters": [
          {
            "name": "_pageUrl",
            "in": "query",
            "required": true,
            "description": "传未编码的URL给HTTP库，由HTTP库编码一次",
            "schema": {
              "type": "string",
              "default": "https://channels.weixin.qq.com/promote/pages/platform/login-iframe"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string"
                  }
                },
                "required": [
                  "token"
                ],
                "additionalProperties": true
              },
              "example": {
                "token": "EXAMPLE_QR_TOKEN"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "检查HTTP及业务错误；201也是正常状态。Cookie值不在示例中。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/LoginStatus"
                    },
                    {
                      "$ref": "#/components/schemas/UpstreamError"
                    }
                  ]
                },
                "example": {
                  "data": {
                    "status": 1,
                    "acctStatus": 1
                  }
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "手机确认后下发promotewebsessionid。此值不会写入文档。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "201": {
            "description": "检查HTTP及业务错误；201也是正常状态。Cookie值不在示例中。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/LoginStatus"
                    },
                    {
                      "$ref": "#/components/schemas/UpstreamError"
                    }
                  ]
                },
                "example": {
                  "data": {
                    "status": 1,
                    "acctStatus": 1
                  }
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "手机确认后下发promotewebsessionid。此值不会写入文档。",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [],
        "x-validation": "live_login_success",
        "description": "请求体传回U1的整个data。status=1且acctStatus=1后检查Set-Cookie并调用U3。"
      }
    },
    "/promote/api/web/transfer/MMFinderPromotionLiveDspApiSvr/getLivePromotionUserProfile": {
      "post": {
        "operationId": "promoteProfile",
        "summary": "U3 核验投手身份",
        "parameters": [
          {
            "name": "_pageUrl",
            "in": "query",
            "required": true,
            "description": "传未编码的URL给HTTP库，由HTTP库编码一次",
            "schema": {
              "type": "string",
              "default": "https://channels.weixin.qq.com/promote/pages/platform/home"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": true
              },
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "检查HTTP及业务错误；201也是正常状态。Cookie值不在示例中。",
