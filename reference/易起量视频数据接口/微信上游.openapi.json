    },
    "/promote/api/web/transfer/MmFinderPromotionApiSvr/searchAccount": {
      "post": {
        "operationId": "promoteAuthorSearch",
        "summary": "U4 搜索作者",
        "parameters": [
          {
            "name": "_pageUrl",
            "in": "query",
            "required": true,
            "description": "传未编码的URL给HTTP库，由HTTP库编码一次",
            "schema": {
              "type": "string",
              "default": "https://channels.weixin.qq.com/promote/pages/platform/create-order"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "flag": {
                    "type": "integer",
                    "format": "int64",
                    "description": "本交付验证值1",
                    "enum": [
                      1
                    ]
                  },
                  "currentPage": {
                    "type": "integer",
                    "format": "int64",
                    "description": "从1开始",
                    "minimum": 1
                  },
                  "pageSize": {
                    "type": "integer",
                    "format": "int64",
                    "description": "上限未核验",
                    "minimum": 1
                  }
                },
                "required": [
                  "query",
                  "flag",
                  "currentPage",
                  "pageSize"
                ],
                "additionalProperties": true
              },
              "example": {
                "query": "风景",
                "flag": 1,
                "currentPage": 1,
                "pageSize": 5
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "检查HTTP及业务错误；201也是正常状态。Cookie值不在示例中。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AuthorList"
                    },
                    {
                      "$ref": "#/components/schemas/UpstreamError"
                    }
                  ]
                },
                "example": {
                  "data": {
                    "list": [
                      {
                        "username": "v_target@finder",
                        "nickName": "示例作者"
                      }
                    ],
                    "totalCount": 1
                  }
                }
              }
            }
          },
          "201": {
            "description": "检查HTTP及业务错误；201也是正常状态。Cookie值不在示例中。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AuthorList"
                    },
                    {
                      "$ref": "#/components/schemas/UpstreamError"
                    }
                  ]
                },
                "example": {
                  "data": {
                    "list": [
                      {
                        "username": "v_target@finder",
                        "nickName": "示例作者"
                      }
                    ],
                    "totalCount": 1
                  }
                }
              }
            }
          }
        },
        "x-validation": "live_nonempty_form_without_baseReq",
        "description": "最小表单已验证可省略baseReq，返回data.list。"
      }
    },
    "/promote/api/web/transfer/MmFinderPromotionApiSvr/getFinderObject": {
      "post": {
        "operationId": "promoteAuthorVideos",
        "summary": "U5 作者作品、文案与互动计数",
        "parameters": [
          {
            "name": "_pageUrl",
            "in": "query",
            "required": true,
            "description": "传未编码的URL给HTTP库，由HTTP库编码一次",
            "schema": {
              "type": "string",
              "default": "https://channels.weixin.qq.com/promote/pages/platform/create-order"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "encryptedUsername": {
                    "type": "string",
                    "description": "目标作者username"
                  },
                  "startTs": {
                    "type": "string",
                    "description": "Unix秒时间戳"
                  },
                  "endTs": {
                    "type": "string",
                    "description": "Unix秒时间戳"
                  },
                  "limit": {
                    "type": "integer",
                    "format": "int64",
                    "description": "已验证1和5，上限未核验",
                    "minimum": 1
                  },
                  "lastBuf": {
                    "type": "string",
                    "description": "后续页传回前页游标"
                  }
                },
                "required": [
                  "encryptedUsername",
                  "startTs",
                  "endTs",
                  "limit"
                ],
                "additionalProperties": true
              },
              "example": {
                "encryptedUsername": "v_target@finder",
                "startTs": "1786320000",
                "endTs": "1794096000",
                "limit": 5
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "检查HTTP及业务错误；201也是正常状态。Cookie值不在示例中。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/VideoPage"
                    },
                    {
                      "$ref": "#/components/schemas/UpstreamError"
                    }
                  ]
                },
                "example": {
                  "data": {
                    "objects": [
                      {
                        "exportId": "EXAMPLE_OPAQUE_EXPORT_ID",
                        "globalExportId": "EXAMPLE_GLOBAL_EXPORT_ID",
                        "nonce": "EXAMPLE_NONCE",
                        "description": "这是已脱敏的视频文案示例",
